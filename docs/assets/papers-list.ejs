```{=html}
<ul class="paper-list">
    <% for (const item of items) { %>
      <li>

        <!-- Title -->
        <paper-title><%= item.title %></paper-title><%
          const authors = (item.coauthors || []).map((name, i) => {
            const link = (item.coauthorLinks || [])[i];
            return link ? `<a href="${link}">${name}</a>` : name;
          });
          let authorText = '';
          if (authors.length === 1) authorText = authors[0];
          else if (authors.length > 1) authorText = authors.slice(0, -1).join(', ') + ' and ' + authors[authors.length - 1];
          const details = [];
          if (item.journalName) details.push(`<em>${item.journalName}</em>`);
          if (item.year) details.push(item.year);
          if (item.status) details.push(`<em>${item.status}</em>`);
          if (item.otherText) details.push(item.otherText);
        %><% if (authorText) { %> with <%= authorText %><% } %><% if (details.length) { %>, <%= details.join(', ') %><% } %>

        <!-- Add break -->
        <br>

        <!-- Preprint Link -->
        <% if (item.preprintLink && item.preprintLink !== '') { %>
        <div class="link-box">
            <a href="<%= item.preprintLink %>">Preprint</a>
        </div>
        <% } %>

        <!-- Published Version -->
        <% if (item.publishedLink && item.publishedLink !== '') { %>
        <div class="link-box">
            <a href="<%= item.publishedLink %>">Published Version</a>
        </div>
        <% } %>

        <!-- Current Draft -->
        <% if (item.draft && item.draft !== '') { %>
        <div class="link-box">
            <a href="<%= item.draft %>" target="_blank">Current Draft</a>
        </div>
        <% } %>

        <!-- arXiv Link -->
        <% if (item.arxiv && item.arxiv !== '') { %>
        <div class="link-box">
            <a href="<%= item.arxiv %>">arXiv</a>
        </div>
        <% } %>

        <!-- Data & Code -->
        <% if (item.replpack && item.replpack !== '') { %>
        <div class="link-box">
            <a href="<%= item.replpack %>">Data & Code</a>
        </div>
        <% } %>

        <!-- Abstract Button and Text Section -->
        <% if (item.abstract && item.abstract !== '') { %>
        <button class="link-box" onclick="toggleAbstract('<%= item.id %>')"> Abstract</button>
        <div id="abstract-<%= item.id %>" class="abstract-text" style="display: none;">
            <%= item.abstract %>
        </div>
        <% } %>


      </li>
    <% } %>
  </ul>
  ```

<script>
function toggleAbstract(id) {
    var abstractDiv = document.getElementById('abstract-' + id);
    if (abstractDiv.style.display === 'none') {
        abstractDiv.style.display = 'block';
    } else {
        abstractDiv.style.display = 'none';
    }
}
</script>